APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

DATA_DIR=./data
OUTPUT_DIR=./outputs
DATABASE_URL=sqlite:///./data/policylens.db

# --- LLM ---
# Offline tests: mock
# Deployment-ready: groq (free tier)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Embeddings ---
# Offline tests: hash
# Deployment-ready: huggingface (free Inference API, 384-d MiniLM)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_TOKEN=
HUGGINGFACE_API_URL=https://router.huggingface.co/hf-inference

# --- Vector store ---
# Offline: local | Deployment: pinecone (index must be dimension 384, cosine)
VECTOR_STORE=pinecone
VECTOR_NAMESPACE=policylens-development
PINECONE_API_KEY=
PINECONE_INDEX_NAME=policylens
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_DIMENSION=384

# --- Graph store ---
# Offline: local | Deployment: neo4j Aura (Render) or docker compose (local)
GRAPH_STORE=neo4j
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USERNAME=xxxx
NEO4J_PASSWORD=
# Aura Free: database name is usually the instance id (same as username), not "neo4j"
NEO4J_DATABASE=xxxx

OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_MIN_TEXT_CHARS=40

TOP_K=8
RERANK_ENABLED=false
MAX_UPLOAD_MB=50

# =============================================================================
# Deployment-ready profile (copy into .env after creating accounts):
#   LLM_PROVIDER=groq
#   LLM_MODEL=llama-3.1-8b-instant
#   GROQ_API_KEY=gsk_...
#   EMBEDDING_PROVIDER=huggingface
#   HF_TOKEN=hf_...
#   VECTOR_STORE=pinecone
#   PINECONE_API_KEY=...
#   GRAPH_STORE=neo4j
#   NEO4J_PASSWORD=policylens_dev_password
# See docs/DEPLOYMENT_SETUP.md
# =============================================================================
