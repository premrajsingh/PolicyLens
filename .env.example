APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

DATA_DIR=./data
OUTPUT_DIR=./outputs
DATABASE_URL=sqlite:///./data/policylens.db

# --- LLM ---
# Offline tests: mock
# Live extraction: groq (provider usage limits and charges may apply)
LLM_PROVIDER=gemini
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Embeddings ---
# Offline tests: hash
# Optional semantic embeddings: huggingface, 384-d MiniLM
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_TOKEN=
HUGGINGFACE_API_URL=https://router.huggingface.co/hf-inference

# --- Vector store ---
# Offline: local | Deployment: pinecone (index must be dimension 384, cosine)
VECTOR_STORE=local
VECTOR_NAMESPACE=policylens-development
PINECONE_API_KEY=
PINECONE_INDEX_NAME=policylens
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_DIMENSION=384

# --- Graph store ---
# Offline: local | Deployment: neo4j via docker compose
GRAPH_STORE=local
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=policylens_dev_password
NEO4J_DATABASE=neo4j

OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_MIN_TEXT_CHARS=40

TOP_K=8
RERANK_ENABLED=false
MAX_UPLOAD_MB=50


# Required for a hosted production review environment.
SERVE_FRONTEND=true
DEMO_USERNAME=reviewer
DEMO_PASSWORD=
MAX_PDF_PAGES=200
MAX_BATCH_FILES=10
